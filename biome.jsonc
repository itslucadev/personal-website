{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "style": {
        // React components in this repo are PascalCase files (Logo.tsx,
        // HeroSection.tsx, ...); everything else stays camelCase/kebab-case.
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "kebab-case", "PascalCase"],
            "requireAscii": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Tailwind v3 directives are not part of standard CSS.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      // Generated by the shadcn/ui CLI and overwritten whenever a component is
      // re-added or updated, so these files are kept exactly as upstream ships
      // them rather than hand-edited to satisfy the linter.
      "includes": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noRedundantRoles": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useConsistentTypeDefinitions": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
